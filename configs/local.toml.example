[remote]
default = "main"

[remote.remotes.main]
ssh_host = "your-host"
repo_path = "~/your/path/vcr-bench"
git_ref = "origin/main"
script_root = "scripts"
attack_results_root = "results/remote_attacks"
accuracy_results_root = "results/accuracy/remote"
sync_strategy = "detach"

[remote.remotes.main.slurm]
container_image = "~/containers/python.sqsh"
container_mounts = "~/your/path/vcr-bench:/work"

[paths]
cache_dir = ".cache/vcr_bench"
data_dir = "data"
results_dir = "results"
remote_results_dir = "remote_results"
